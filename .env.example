# --- database ---
POSTGRES_USER=peach
POSTGRES_PASSWORD=peach
POSTGRES_DB=peach
POSTGRES_PORT=5432

# --- backend ---
DATABASE_URL=postgresql+asyncpg://peach:peach@db:5432/peach
BACKEND_PORT=8000
APP_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

# --- frontend ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://backend:8000

# --- aws (make deploy-backend / deploy-frontend / domain) ---
# Everything lands in us-east-1, tagged PROJECT_NAME=<PROJECT_NAME>. Every
# other knob has a default in the scripts or templates and can still be set
# here to override it.
AWS_REGION=us-east-1
PROJECT_NAME=peach
# Blank keys fall back to AWS_PROFILE, SSO, or an instance role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PROFILE=

# The deployed frontend's origin, once it has one.
API_CORS_ORIGINS=*

# --- google sign-in (make deploy-cognito) ---
# An OAuth client from Google Cloud. Leave blank for email + password only;
# fill in and re-run make deploy-cognito to add Google. Its authorised
# redirect URI is printed by the deploy.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- weekly report (make deploy-reports) ---
# Send from reports@<domain>; its SES identity prints three DKIM CNAMEs to add.
REPORTS_MAIL_DOMAIN=
# Comma-separated. While SES is in the sandbox, each gets a verification link first.
REPORT_RECIPIENTS=
# Blank: Mondays at 07:00 Kyiv time. "rate(5 minutes)" to watch it fire, then blank again.
REPORTS_SCHEDULE=
# One ISO week (e.g. 2026-W30) the builder fails on purpose - the dead-letter exercise.
REPORTS_FAIL_WEEK=

# --- agenda parser (make deploy-ai) ---
# Blank: anthropic.claude-opus-5-5. anthropic.claude-haiku-5-5 costs ~40 times less.
PARSER_MODEL=
# Who the $5 monthly budget alarm emails. Blank: the first REPORT_RECIPIENTS.
BUDGET_EMAIL=

# --- written by the scripts, not by hand ---
# make deploy-cognito: the user pool the backend and frontend sign in against.
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
COGNITO_GOOGLE_ENABLED=false
# make deploy-backend: the function URL. make deploy-frontend builds against it.
BACKEND_URL=
# make deploy-ai: the parser's function URL. make deploy-frontend builds against it.
PARSER_URL=
# make domain DOMAIN=app.example.com: the frontend's custom domain.
DOMAIN_NAME=
