# The peach-prod workspace's working directory is infra/, so a run started from
# a laptop uploads the whole repository root. Only infra/ goes up - and never
# .env, whatever the rules above it say (the last matching rule wins).
*
!infra/
!infra/**
infra/.terraform/
infra/bootstrap/
.env
.env.*

# Lab 9 has its own working directory and state. Both root modules must be
# uploadable, but local bootstrap state, inputs and build artifacts must not.
!gcp/
!gcp/**
gcp/.terraform/
gcp/bootstrap/
gcp/*.tfvars
gcp/*.auto.tfvars
gcp/*.tfstate*
gcp/*.tfplan
gcp/.env*
