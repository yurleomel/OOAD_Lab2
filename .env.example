# --- database ---
POSTGRES_USER=peach
POSTGRES_PASSWORD=peach
POSTGRES_DB=peach
POSTGRES_PORT=5432

# --- backend ---
DATABASE_URL=postgresql+asyncpg://peach:peach@db:5432/peach
BACKEND_PORT=8000
APP_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

# --- frontend ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://backend:8000

# --- aws (make deploy-backend / deploy-frontend / domain) ---
# Everything lands in us-east-1, tagged PROJECT_NAME=<PROJECT_NAME>. Every
# other knob has a default in the scripts or templates and can still be set
# here to override it.
AWS_REGION=us-east-1
PROJECT_NAME=peach
# Blank keys fall back to AWS_PROFILE, SSO, or an instance role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PROFILE=

# The deployed frontend's origin, once it has one.
API_CORS_ORIGINS=*

# Google sign-in, the weekly report's mail settings and schedule, the parser's
# model and the budget alarm are Terraform variables now: non-secret ones in
# infra/terraform.tfvars, secrets and addresses in the HCP Terraform workspace.

# --- agenda parser from the laptop (make parse, make llm-hello) ---
# Blank: converse + us.anthropic.claude-haiku-4-5-20251001-v1:0 (what this account can call).
# The lab's model: PARSER_API=messages, PARSER_MODEL=anthropic.claude-opus-5-5.
PARSER_API=
PARSER_MODEL=

# --- written by the scripts, not by hand ---
# make infra-env: the user pool the backend and frontend sign in against.
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
COGNITO_GOOGLE_ENABLED=false
# make deploy-backend: the function URL. make deploy-frontend builds against it.
BACKEND_URL=
# make infra-env: the parser's function URL. make deploy-frontend builds against it.
PARSER_URL=
# make domain DOMAIN=app.example.com: the frontend's custom domain.
DOMAIN_NAME=
